  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidRegion
      suffix: -liquid1
      drawLiquid: er-steam
      alpha: 0.7
      padding: 2
    } 
    {
      type: DrawRegion
      suffix: -rotator
      spinSprite: true
      rotateSpeed: 6
    }
    {
      type: DrawRegion
      suffix: -ac-rotator
      spinSprite: true
      rotateSpeed: -6
    }
    {
      type: DrawRegion
      suffix: -top
    } 
  ]
}