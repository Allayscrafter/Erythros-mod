  effect: {
  type: ParticleEffect
  particles: 10
  sizeFrom: 2.5
  sizeTo: 0.2
  colorFrom: eeeeeeee
  colorTo: eeeeee00
  length: 15
  lifetime: 40
  cone: 360
  interp: pow3Out
  sizeInterp: pow2Out
  line: false
}
}
ambientSound: extractLoop
ambientSoundVolume: 0.06
squareSprite: false
requirements: [
  er-tin/100
  er-stanno-bismuth-glass/50
  er-bismuth/45
]
