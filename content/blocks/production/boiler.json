      padLeft: 1.1
      padTop: 1.1
      padBottom: 1.1
      padRight: 1.1
    }
    {
      type: DrawLiquidTile
      drawLiquid: er-steam
      padLeft: 6.5
      padTop: 6.5
      padBottom: 6.5
      padRight: 6.5
    }
    {
      type: DrawRegion
      suffix: -top
    }
    {
      type: DrawHeatInput
      suffix: -heat
    } 
  ]
