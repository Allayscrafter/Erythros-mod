size: 3
hasLiquids: true
hasItems: true
squareSprite: false
category: crafting
consumes: {
    power: 1.8
    items: [
      er-lithium/3
    ]
}
outputLiquids: [
    er-hyd/0.25,
    er-helium/0.125
]
liquidOutputDirections: [1,3]
