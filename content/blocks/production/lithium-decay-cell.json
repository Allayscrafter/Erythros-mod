      type: DrawLiquidTile
      drawLiquid: er-hyd
      padding: 2
    }
    {
      type: DrawLiquidTile
      drawLiquid: er-helium
      padding: 2
    }
    {
      type: DrawRegion
      suffix: -top
    }
    {
      type: DrawLiquidOutputs
    }
  ]
}